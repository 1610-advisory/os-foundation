# Each area is its own repo. The company repo never tracks them.
/areas/

# Each person's workspace is its own private repo (team level).
/users/

# Library: git holds text only. Media and data stay on this computer.
/library/media/*
!/library/media/LOCAL.md
/library/data/

# Secrets and machine files
.env
.env.*
*.pem
*.key
credentials*.json
token*.json
.claude/settings.local.json
.DS_Store
.obsidian/workspace*.json
