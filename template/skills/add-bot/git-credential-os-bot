#!/bin/bash
# Git credential helper. get only. Never logs the token.
set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$DIR/lib.sh"

usage() {
  cat << 'EOF'
Usage: git-credential-os-bot get

Git credential helper. get only. store and erase do nothing.
The token comes from host.sh get-token --bot <bot>.
It answers only for this company's host. Any other request prints nothing.
The bots switch must be on. OS_BOT and the company root come from the wrapper.
OS_NOW fakes the clock. OS_BOT_TOKEN_TTL fakes the token life.
The password line is the git protocol. It is not a log.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

op=${1:-}
case "$op" in
  get) ;;
  store|erase)
    while IFS= read -r line || [ -n "$line" ]; do
      [ -z "$line" ] && break
    done
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    printf '%s\n' "only get is supported" >&2
    exit 1
    ;;
esac

protocol=""
host=""
req_path=""
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    path=*) req_path=${line#path=} ;;
    password=*) ;;
    *) ;;
  esac
done

# A miss prints nothing and exits 0 so git tries the next helper.
bot_miss() {
  exit 0
}

bot_release_lock() {
  if [ -n "${BOT_LOCK:-}" ]; then
    rmdir "$BOT_LOCK" 2>/dev/null || true
    BOT_LOCK=""
  fi
}

trap 'bot_release_lock; bot_cleanup' EXIT

# The wrapper sets OS_BOT and the company root. Do not guess from me.
if [ -z "${OS_BOT:-}" ]; then
  bot_miss
fi
BOT=$OS_BOT
bot_slug_ok "bot" "$BOT"

if [ -n "${OS_ROOT:-}" ] && [ -f "${OS_ROOT}/company-profile.md" ]; then
  BOT_ROOT=$(cd "$OS_ROOT" && pwd -P)
elif [ -n "${OS_PROFILE:-}" ] && [ -f "$OS_PROFILE" ]; then
  BOT_ROOT=$(cd "$(dirname "$OS_PROFILE")" && pwd -P)
else
  bot_miss
fi
export BOT_ROOT
export OS_PROFILE="${BOT_ROOT}/company-profile.md"

if ! bot_has_switch bots; then
  bot_miss
fi

page=$(bot_profile)
host_kind=$(bot_field "$page" host || true)
host_kind=$(bot_trim "$host_kind")
host_url=$(bot_field "$page" host_url || true)
host_url=$(bot_trim "$host_url")
want_proto=""
want_host=""
if [ "$host_kind" = "github" ] && [ -z "$host_url" ]; then
  want_proto=https
  want_host=github.com
elif [ -n "$host_url" ]; then
  case "$host_url" in
    *://*)
      want_proto=${host_url%%://*}
      rest=${host_url#*://}
      want_host=${rest%%/*}
      ;;
    *)
      bot_miss
      ;;
  esac
else
  bot_miss
fi
if [ "$protocol" != "$want_proto" ] || [ "$host" != "$want_host" ]; then
  bot_miss
fi

bot_page="${BOT_ROOT}/bots/${BOT}/BOT.md"
if [ -n "$req_path" ]; then
  repo=${req_path%.git}
  repo=${repo%/}
  repo=${repo##*/}
  granted=0
  if [ -f "$bot_page" ]; then
    while IFS= read -r name; do
      [ "$name" = "$repo" ] && granted=1
    done << EOF
$(bot_field "$bot_page" repos || true)
EOF
  fi
  if [ "$granted" -ne 1 ]; then
    bot_miss
  fi
fi

ttl=${OS_BOT_TOKEN_TTL:-3600}
case "$ttl" in
  *[!0-9]*|"") bot_die 1 "OS_BOT_TOKEN_TTL must be a number" ;;
esac
if [ "$ttl" -lt 1 ]; then
  bot_die 1 "OS_BOT_TOKEN_TTL must be at least 1"
fi
now=$(bot_now_epoch)
margin=300
if [ "$ttl" -le 300 ]; then
  margin=0
fi

cfg=$(bot_config_dir)
cache_dir="${cfg}/bots/${BOT}"
mkdir -p "$cache_dir"
chmod 700 "$cfg" "${cfg}/bots" "$cache_dir"
cache="${cache_dir}/token-cache"
BOT_LOCK="${cache_dir}/token-cache.lock"
tries=0
while ! mkdir "$BOT_LOCK" 2>/dev/null; do
  tries=$((tries + 1))
  if [ "$tries" -gt 30 ]; then
    bot_die 3 "token cache is locked"
  fi
  sleep 1
done

use_cache=0
cached=""
exp=0
if [ -f "$cache" ] && [ ! -L "$cache" ]; then
  content=$(cat "$cache")
  exp=$(printf '%s\n' "$content" | sed -n 's/^expiry=//p' | head -n 1)
  cached=$(printf '%s\n' "$content" | sed -n 's/^token=//p' | head -n 1)
  case "$exp" in
    ""|*[!0-9]*) exp=0 ;;
  esac
  left=$((exp - now))
  if [ -n "$cached" ]; then
    if [ "$margin" -eq 0 ]; then
      if [ "$left" -gt 0 ]; then
        use_cache=1
      fi
    elif [ "$left" -ge "$margin" ]; then
      use_cache=1
    fi
  fi
fi

trace_word="refresh"
if [ "$use_cache" -eq 1 ]; then
  token=$cached
  trace_word="cache"
else
  host_sh=$(bot_host_sh)
  err=$(bot_mktemp)
  set +e
  token=$(bash "$host_sh" get-token --bot "$BOT" 2>"$err")
  rc=$?
  set -e
  if [ "$rc" -ne 0 ] || [ -z "$token" ]; then
    scrub=$(bot_mktemp)
    OS_SCRUB=$token bot_scrub_file "$err" "$scrub"
    if [ -s "$scrub" ]; then
      cat "$scrub" >&2
    else
      printf '%s\n' "get-token failed" >&2
    fi
    exit "${rc:-3}"
  fi
  case "$token" in
    *$'\n'*) bot_die 3 "get-token returned more than one line" ;;
  esac
  exp=$((now + ttl))
  if [ -L "$cache" ]; then
    bot_die 4 "refusing a symlink cache"
  fi
  tmp=$(bot_mktemp)
  {
    printf 'expiry=%s\n' "$exp"
    printf 'token=%s\n' "$token"
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$cache"
  chmod 600 "$cache"
fi
bot_release_lock

if [ -n "${OS_BOT_TOKEN_TRACE:-}" ]; then
  printf '%s\n' "$trace_word" >> "$OS_BOT_TOKEN_TRACE"
fi

user=""
if [ -f "$bot_page" ]; then
  user=$(bot_field "$bot_page" bot_user || true)
fi
[ -n "$user" ] || user=$BOT
case "$host_kind" in
  github) user="x-access-token" ;;
esac

printf 'protocol=%s\n' "$protocol"
printf 'host=%s\n' "$host"
printf 'username=%s\n' "$user"
printf 'password=%s\n' "$token"
printf '\n'
