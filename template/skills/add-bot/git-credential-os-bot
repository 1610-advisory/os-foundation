#!/bin/bash
# Git credential helper. get only. Never logs the token.
set -euo pipefail

DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
. "$DIR/lib.sh"

usage() {
  cat << 'EOF'
Usage: git-credential-os-bot get

Git credential helper. get only. store and erase do nothing.
The token comes from host.sh get-token --bot <bot>.
It is cached with its expiry. It refreshes when under 5 minutes remain.
OS_NOW fakes the clock. OS_BOT_TOKEN_TTL fakes the token life.
The password line is the git protocol. It is not a log.
EOF
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

op=${1:-}
case "$op" in
  get) ;;
  store|erase)
    # Drain stdin. Do not log it. It may hold a password.
    while IFS= read -r line || [ -n "$line" ]; do
      [ -z "$line" ] && break
    done
    exit 0
    ;;
  "")
    usage >&2
    exit 1
    ;;
  *)
    printf '%s\n' "only get is supported" >&2
    exit 1
    ;;
esac

protocol=""
host=""
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case "$line" in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
    password=*) ;;
    *) ;;
  esac
done

bot_resolve_bot() {
  if [ -n "${OS_BOT:-}" ]; then
    printf '%s\n' "$OS_BOT"
    return 0
  fi
  local cfg
  if [ -n "${OS_SLUG:-}" ]; then
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/${OS_SLUG}-os"
    if [ -f "${cfg}/me" ]; then
      bot_trim "$(cat "${cfg}/me")"
      return 0
    fi
  fi
  local base dir
  base="${XDG_CONFIG_HOME:-$HOME/.config}"
  for dir in "$base"/*-os; do
    [ -f "$dir/me" ] || continue
    bot_trim "$(cat "$dir/me")"
    return 0
  done
  return 1
}

bot_resolve_root() {
  if [ -n "${OS_ROOT:-}" ] && [ -f "${OS_ROOT}/company-profile.md" ]; then
    (cd "$OS_ROOT" && pwd -P)
    return 0
  fi
  if [ -n "${OS_PROFILE:-}" ] && [ -f "$OS_PROFILE" ]; then
    (cd "$(dirname "$OS_PROFILE")" && pwd -P)
    return 0
  fi
  local dir parent
  dir=$(pwd -P)
  while true; do
    if [ -f "$dir/company-profile.md" ]; then
      printf '%s\n' "$dir"
      return 0
    fi
    parent=$(dirname "$dir")
    if [ "$parent" = "$dir" ]; then
      break
    fi
    dir=$parent
  done
  local base item root
  base="${XDG_CONFIG_HOME:-$HOME/.config}"
  for item in "$base"/*-os/root; do
    [ -f "$item" ] || continue
    root=$(bot_trim "$(cat "$item")")
    if [ -f "${root}/company-profile.md" ]; then
      printf '%s\n' "$root"
      return 0
    fi
  done
  return 1
}

BOT=$(bot_resolve_bot) || bot_die 4 "bot slug is not set"
bot_slug_ok "bot" "$BOT"
BOT_ROOT=$(bot_resolve_root) || bot_die 1 "company-profile.md not found"
export BOT_ROOT
export OS_PROFILE="${BOT_ROOT}/company-profile.md"

ttl=${OS_BOT_TOKEN_TTL:-3600}
case "$ttl" in
  *[!0-9]*|"") bot_die 1 "OS_BOT_TOKEN_TTL must be a number" ;;
esac
if [ "$ttl" -lt 1 ]; then
  bot_die 1 "OS_BOT_TOKEN_TTL must be at least 1"
fi
now=$(bot_now_epoch)
margin=300
if [ "$ttl" -le 300 ]; then
  margin=0
fi

cfg=$(bot_config_dir)
cache="${cfg}/bots/${BOT}/token-cache"
mkdir -p "${cfg}/bots/${BOT}"
chmod 700 "$cfg" "${cfg}/bots" "${cfg}/bots/${BOT}"

use_cache=0
cached=""
if [ -f "$cache" ] && [ ! -L "$cache" ]; then
  exp=$(sed -n 's/^expiry=//p' "$cache" | head -n 1)
  cached=$(sed -n 's/^token=//p' "$cache" | head -n 1)
  case "$exp" in
    ""|*[!0-9]*) exp=0 ;;
  esac
  left=$((exp - now))
  if [ -n "$cached" ]; then
    if [ "$margin" -eq 0 ]; then
      if [ "$left" -gt 0 ]; then
        use_cache=1
      fi
    elif [ "$left" -ge "$margin" ]; then
      use_cache=1
    fi
  fi
fi

trace_word="refresh"
if [ "$use_cache" -eq 1 ]; then
  token=$cached
  trace_word="cache"
else
  host_sh=$(bot_host_sh)
  err=$(bot_mktemp)
  set +e
  token=$(bash "$host_sh" get-token --bot "$BOT" 2>"$err")
  rc=$?
  set -e
  if [ "$rc" -ne 0 ] || [ -z "$token" ]; then
    scrub=$(bot_mktemp)
    OS_SCRUB=$token bot_scrub_file "$err" "$scrub"
    if [ -s "$scrub" ]; then
      cat "$scrub" >&2
    else
      printf '%s\n' "get-token failed" >&2
    fi
    exit "${rc:-3}"
  fi
  case "$token" in
    *$'\n'*) bot_die 3 "get-token returned more than one line" ;;
  esac
  exp=$((now + ttl))
  if [ -L "$cache" ]; then
    bot_die 4 "refusing a symlink cache"
  fi
  tmp=$(bot_mktemp)
  {
    printf 'expiry=%s\n' "$exp"
    printf 'token=%s\n' "$token"
  } > "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$cache"
  chmod 600 "$cache"
fi

if [ -n "${OS_BOT_TOKEN_TRACE:-}" ]; then
  printf '%s\n' "$trace_word" >> "$OS_BOT_TOKEN_TRACE"
fi

page=$(bot_profile)
user=""
bot_page="${BOT_ROOT}/bots/${BOT}/BOT.md"
if [ -f "$bot_page" ]; then
  user=$(bot_field "$bot_page" bot_user || true)
fi
[ -n "$user" ] || user=$BOT
host_kind=$(bot_field "$page" host || true)
case "$host_kind" in
  github) user="x-access-token" ;;
esac

[ -n "$protocol" ] && printf 'protocol=%s\n' "$protocol"
[ -n "$host" ] && printf 'host=%s\n' "$host"
printf 'username=%s\n' "$user"
printf 'password=%s\n' "$token"
printf '\n'
